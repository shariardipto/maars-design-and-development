APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/mddl.sqlite
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# One-time CLI bootstrap; remove the password after running npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Provider secrets are never exposed through admin APIs or browser code.
OPENAI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
